# Copy to .env and adjust. All optional.

# Host port the game is published on (http://<host>:APP_PORT).
APP_PORT=3001

# Only for `docker compose --profile https up -d --build`: the public domain Caddy should
# get an HTTPS certificate for. Its DNS must point at this machine, with ports 80 and 443 open.
# DOMAIN=sabacc.example.com

# Only for `docker compose --profile tailscale up -d --build` (Tailscale sidecar).
# Auth key from https://login.tailscale.com/admin/settings/keys (only needed on first start;
# leave empty to log in via the URL in `docker compose logs tailscale` instead).
# TS_AUTHKEY=tskey-auth-...
# Machine name on the tailnet: the game is served at https://<TS_HOSTNAME>.<tailnet>.ts.net
# TS_HOSTNAME=sabacc
# funnel.json = public on the internet via Tailscale Funnel (default); serve.json = tailnet only.
# TS_SERVE_CONFIG_FILE=funnel.json
# Extra `tailscale up` flags, e.g. --advertise-tags=tag:container
# TS_EXTRA_ARGS=
# Tip: with the sidecar, set APP_PORT=127.0.0.1:3001 so the game isn't exposed on the LAN directly.
